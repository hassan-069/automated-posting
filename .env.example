# Copy to .env and fill in the platforms you want to use.
# Platforms with missing credentials are reported as "failed" and skipped.

REQUEST_TIMEOUT=15
PLATFORM_TIMEOUT=30

# Dev.to -> https://dev.to/settings/extensions (Generate API key)
DEVTO_API_KEY=

# Mastodon -> Preferences > Development > New application (scope: write:statuses)
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky -> Settings > Privacy and Security > App Passwords
# Use the full handle, e.g. yourname.bsky.social
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social

# Hugging Face -> https://huggingface.co/settings/tokens (token with write access)
HF_TOKEN=
# Optional: repo used for the post, defaults to <your-username>/announcements
HF_REPO_ID=

# GitHub Gist -> fine-grained or classic token with "gist" scope
GITHUB_TOKEN=